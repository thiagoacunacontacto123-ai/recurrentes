{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/mp/webhook.js": {
      "maxDuration": 60
    },
    "api/checkout/init.js": {
      "maxDuration": 30
    },
    "api/subscribers.js": {
      "maxDuration": 60
    },
    "api/public.js": {
      "maxDuration": 60
    },
    "api/stats.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/widget.js",
      "destination": "/api/widget"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://recurrentes-16fbd.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://recurrentes-16fbd.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/api/tiendanube/callback",
      "destination": "/api/shopify?action=tn-callback"
    },
    {
      "source": "/api/tiendanube/webhooks",
      "destination": "/api/shopify?action=tn-webhooks"
    },
    {
      "source": "/((?!api/|@|src/|node_modules/|.+\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/widget",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PATCH, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Merchant-Id, X-Admin-As"
        }
      ]
    },
    {
      "source": "/landing/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron?action=sync-all-pending",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron?action=run-flows",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron?action=retry-fulfillment",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron?action=reconcile-mp",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron?action=sync-saas-tiers",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron?action=bill-wa-usage",
      "schedule": "30 9 * * *"
    }
  ]
}
