// Firestore Security Rules para Recurrentes.
//
// Modelo de acceso:
//   - TODAS las escrituras (merchants, plans, subscribers, charges, email_log,
//     etc.) pasan por endpoints serverless de /api/* con el Admin SDK, que
//     bypassea estas rules. Por eso el cliente NUNCA escribe: así el merchant
//     no puede setear plan:"pro", abandoned_enabled, inventar charges, etc.
//   - LECTURAS también por API (desde 2026-09-15). El panel usa el Web SDK solo
//     para Auth; no lee Firestore. Antes merchants/{mid} era legible por su login,
//     el perfil dueño y el equipo (teamUids): cualquier miembro del equipo podía
//     leer con el SDK web mp_access_token, mp_refresh_token, shopify_token,
//     shopify_client_secret, klaviyo_api_key y meta_capi_token, aunque la API se
//     los oculte y le prohíba tocar integraciones. Ahora: cerrado del todo.
//   - El widget del storefront y el portal del cliente final NO usan Firebase
//     Web SDK directamente — todo pasa por /api/public/* con tokens firmados.
//
// Después de editar este archivo, copialo al Firebase Console:
//   Firestore Database → Rules → Pegá el contenido → Publish.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // merchants/{mid} y TODAS sus subcolecciones (plans, subscribers, charges,
    // email_log, flows…): el cliente no lee ni escribe. Todo va por /api/*
    // (Admin SDK), que aplica dueño / equipo / permisos por sección.
    match /merchants/{mid} {
      allow read, write: if false;
      match /{subcol}/{docId=**} {
        allow read, write: if false;
      }
    }

    // Transferencias de tiendas, perfiles de logins sin tienda principal y
    // auditoría: solo Admin SDK (api/_lib/transfer.js).
    match /store_transfers/{id} {
      allow read, write: if false;
    }
    match /profiles/{uid} {
      allow read, write: if false;
    }
    match /audit_log/{id} {
      allow read, write: if false;
    }

    // Internos (rate limits, tokens temporales): solo Admin SDK.
    match /ratelimits/{key} {
      allow read, write: if false;
    }
    match /shopify_pending/{state} {
      allow read, write: if false;
    }
    // Pedidos de demo (#/demo): los escribe el Admin SDK desde public.js y solo
    // los lee el Admin. Tienen WhatsApp y mail de gente que todavía no es cliente.
    match /demo_leads/{id} {
      allow read, write: if false;
    }

    // Por defecto, todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
