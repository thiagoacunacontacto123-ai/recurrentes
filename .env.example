# ─── Firebase (Admin SDK, server-side) ───────────────────────
# Service account credentials. Crear en Firebase Console → Project Settings →
# Service accounts → "Generate new private key". Pegar acá el contenido del JSON
# en sus 3 campos: project_id, client_email, private_key.
FIREBASE_PROJECT_ID=recurrentes-app
[email protected]
# Importante: la private_key tiene \n literales que hay que respetar.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkq...\n-----END PRIVATE KEY-----\n"

# ─── Firebase Web SDK (client-side, prefijo VITE_) ───────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=recurrentes-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=recurrentes-app
VITE_FIREBASE_STORAGE_BUCKET=recurrentes-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Mercado Pago — credentials globales de la plataforma ────
# Estas son las credentials de la APP que registra Recurrentes en MP
# Developers — sirven para implementar OAuth para que cada comerciante
# conecte su propia cuenta MP. Si elegimos paste-token en lugar de OAuth,
# solo necesitamos las del front (Public Key) y cada merchant pega su
# Access Token desde el admin.
#
# OAuth (el comerciante conecta en un clic): MP_APP_ID + MP_CLIENT_SECRET son el
# "Client ID" y "Client Secret" de la app de Recurrentes en
# https://www.mercadopago.com.ar/developers/panel/app (credenciales de producción).
# Sin las dos, el panel solo ofrece pegar el Access Token.
MP_APP_ID=
MP_CLIENT_SECRET=
# Tiene que ser IDÉNTICA a la "URL de redireccionamiento" cargada en la app de MP.
# Si falta, se arma con APP_BASE_URL + /api/mp/oauth-callback.
MP_REDIRECT_URI=https://www.recurrentesapp.com/api/mp/oauth-callback
# PKCE (S256) va activo por defecto: activalo también en la app de MP (Editar →
# PKCE). Poné "off" solo si en la app de MP queda desactivado.
MP_OAUTH_PKCE=

# ─── Shopify ──────────────────────────────────────────────────
# Cada comerciante crea SU app en dev.shopify.com/dashboard y pega en el panel
# dominio + Client ID + Client Secret (se guardan en su doc, no acá).
# SHOPIFY_API_KEY/SECRET son OPCIONALES: solo si algún día hay una app única de
# Recurrentes. Vacías = cada comerciante usa su propia app (lo normal hoy).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Permisos: la lista vive en shared/platform/shopify.js
# (read_products,read_orders,write_orders,read_customers,write_customers,read_shipping).
# Esta env es OPCIONAL y solo SUMA permisos extra a esa lista; no hace falta cargarla.
SHOPIFY_SCOPES=
SHOPIFY_REDIRECT_URI=https://recurrentes-app.vercel.app/api/shopify/oauth-callback

# ─── App ──────────────────────────────────────────────────────
APP_BASE_URL=https://recurrentes-app.vercel.app
# Secret para validar webhooks MP (opcional pero recomendado)
MP_WEBHOOK_SECRET=

# ─── Pasarelas alternativas (api/_lib/providers) ──────────────
# Cada pasarela se prende con su flag. Apagado = no se ofrece ni se conecta
# (los avisos de suscripciones ya creadas se siguen procesando).
MOBBEX_ENABLED=
# Opcional: API Key de la app de Recurrentes en Mobbex (si no está, cada
# comerciante pega la suya además de su Access Token).
MOBBEX_API_KEY=
# Opcional: 1 = todas las suscripciones Mobbex en modo prueba (test:true).
MOBBEX_TEST=
# Opcional: secreto para el token de las URLs de webhook de pasarelas
# (si falta se usa PORTAL_SECRET / MP_WEBHOOK_SECRET). No rotar sin migrar.
PROVIDER_WEBHOOK_SECRET=
# Secreto de los links del portal / baja de mails / state de OAuth. Si falta se
# usa MP_WEBHOOK_SECRET (los links viejos siguen andando).
PORTAL_SECRET=
# Clave secreta de firma de webhooks de MP (Tus integraciones → Webhooks). Con
# la clave cargada, api/mp/webhook.js verifica el header x-signature.
MP_WEBHOOK_SIGNING_SECRET=
# (Propuesta de auditoría, se lee en _lib/webhookguard.js) "1" = rechazar
# notificaciones de MP sin firma válida. Vacío = solo verificar y loguear.
MP_WEBHOOK_ENFORCE=
# Auth del cron de Vercel (Authorization: Bearer). Obligatorio en producción.
CRON_SECRET=
# ─── WhatsApp Business Cloud API (Meta) — avisos a clientes finales ────
# Cada comerciante pega SUS credenciales en Integraciones → WhatsApp (se guardan en
# su doc, nunca acá). Estas variables son de la plataforma y son opcionales:
# Versión de la Graph API (formato vNN.N). Vacío = la que trae el código (v25.0).
WHATSAPP_GRAPH_VERSION=
# App secret de la app de Meta de Recurrentes: firma X-Hub-Signature-256 del webhook
# /api/public?action=wa-webhook (hace falta con Embedded Signup; con apps propias de
# cada comerciante se usa el app secret que pega él en Integraciones).
WHATSAPP_APP_SECRET=
# Token que Meta manda al verificar el webhook (lo inventás vos, cualquier texto largo).
WHATSAPP_VERIFY_TOKEN=
# Futuro (Embedded Signup, conexión en 1 clic; todavía no se usan en el código):
# WHATSAPP_APP_ID=
# WHATSAPP_ES_CONFIG_ID=
# ─── Tests (solo local, `npm test`) ───────────────────────────
# Los tests pisan todas las variables de arriba con valores falsos y no usan red.
# 1 = mostrar los console.log del código mientras corren los tests.
# RECURRENTES_TEST_VERBOSE=1
# ─── Super-admin (panel #/admin) ─────────────────────────────
# Emails separados por coma que pueden entrar al panel de administración y usar
# "ver como" (sin distinguir mayúsculas). El login tiene que tener el email
# verificado. Vacía = nadie es admin (no hay lista de respaldo en el código).
# No confundir con ADMIN_EMAIL (singular): a quién le llega el aviso de plan-request.
ADMIN_EMAILS=
# ─── Stripe (cobros en USD, cuentas conectadas por Connect OAuth) ───
# Apagado por defecto: con STRIPE_ENABLED vacío el panel muestra "Próximamente".
STRIPE_ENABLED=
# Clave secreta de la cuenta PLATAFORMA de Recurrentes (sk_test_… para probar, sk_live_… en real)
STRIPE_SECRET_KEY=
# Stripe → Settings → Connect → Onboarding options → OAuth → client_id (ca_…)
STRIPE_CONNECT_CLIENT_ID=
# Secreto whsec_… del webhook (endpoint "Cuentas conectadas"). Si hay dos endpoints, separados por coma.
STRIPE_WEBHOOK_SECRET=
# Opcional: si no, ${APP_BASE_URL}/api/merchant?action=stripe-connect-callback
STRIPE_CONNECT_REDIRECT_URI=

# ─── Whop (membresías / digitales en USD; cada merchant pega su API key) ───
WHOP_ENABLED=
# Opcional: secreto ws_… de un webhook a nivel APP de Whop (si no, se usa el que carga cada merchant)
WHOP_WEBHOOK_SECRET=
